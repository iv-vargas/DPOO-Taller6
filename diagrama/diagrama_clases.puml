@startuml diagrama_clases
title Taller 6 - Diario de Restaurantes (Swing)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
set separator none
hide empty members

' Lectura del diagrama:
'   - Las ventanas (JFrame) están arriba, los paneles (JPanel) en el medio
'     y las superclases / interfaces de Swing abajo.
'   - Una asociación entre una ventana y su panel es bidireccional: la ventana
'     contiene al panel (composición) y el panel guarda una referencia a la ventana.
'     Los nombres de rol en cada extremo son los atributos de cada clase.

' =====================================================================
' Mundo
' =====================================================================
package "uniandes.dpoo.swing.mundo" {
    class Diario {
        - restaurantes : List<Restaurante>
        + Diario()
        + getRestaurantes(completos : boolean) : List<Restaurante>
        + agregarRestaurante(restaurante : Restaurante) : void
    }

    class Restaurante {
        - nombre : String
        - calificacion : int
        - coordenadaX : int
        - coordenadaY : int
        + visitado : boolean
        + Restaurante(nombre : String, calificacion : int, x : int, y : int, visitado : boolean)
        + getNombre() : String
        + getCalificacion() : int
        + getX() : int
        + getY() : int
        + isVisitado() : boolean
        + toString() : String
    }
}

' =====================================================================
' Interfaz - ventana del mapa
' =====================================================================
package "uniandes.dpoo.swing.interfaz.mapa" {
    class VentanaMapa {
        - {static} VISITADOS : String = "VISITADOS"
        - {static} TODOS : String = "TODOS"
        - panelMapa : PanelMapaVisualizar
        - radioTodos : JRadioButton
        - radioVisitados : JRadioButton
        - ventanaPrincipal : VentanaPrincipal
        + VentanaMapa(ventanaPrincipal : VentanaPrincipal, restaurantes : List<Restaurante>)
        + actionPerformed(e : ActionEvent) : void
    }

    class PanelMapaVisualizar {
        - labMapa : JLabel
        - restaurantes : List<Restaurante>
        + PanelMapaVisualizar()
        + paint(g : Graphics) : void
        + actualizarMapa(nuevosRestaurantes : List<Restaurante>) : void
    }
}

' =====================================================================
' Interfaz - ventana principal
' =====================================================================
package "uniandes.dpoo.swing.interfaz.principal" {
    class VentanaPrincipal {
        - mundo : Diario
        - pBotones : PanelBotones
        - pDetalles : PanelDetallesRestaurante
        - pLista : PanelLista
        - ventanaMapa : VentanaMapa
        - ventanaAgregar : VentanaAgregarRestaurante
        + VentanaPrincipal(elDiario : Diario)
        + mostrarVetanaNuevoRestaurante() : void
        + mostrarVentanaMapa() : void
        + agregarRestaurante(nombre : String, calificacion : int, x : int, y : int, visitado : boolean) : void
        + getRestaurantes(completos : boolean) : List<Restaurante>
        - actualizarRestaurantes() : void
        + cambiarRestauranteSeleccionado(seleccionado : Restaurante) : void
        + {static} main(args : String[]) : void
    }

    class PanelBotones {
        - {static} NUEVO : String = "nuevo"
        - {static} VER : String = "ver"
        - butNuevo : JButton
        - butVerTodos : JButton
        - ventanaPrincipal : VentanaPrincipal
        + PanelBotones(ventanaPrincipal : VentanaPrincipal)
        + actionPerformed(e : ActionEvent) : void
    }

    class PanelLista {
        - listaDeRestaurantes : JList<Restaurante>
        - dataModel : DefaultListModel<Restaurante>
        - ventanaPrincipal : VentanaPrincipal
        + PanelLista(ventanaPrincipal : VentanaPrincipal)
        + actualizarRestaurantes(restaurantes : List<Restaurante>) : void
        + valueChanged(e : ListSelectionEvent) : void
        + seleccionarRestaurante(restaurante : Restaurante) : void
    }

    class PanelDetallesRestaurante {
        - labNombre : JLabel
        - labCalificacion : JLabel
        - chkVisitado : JCheckBox
        + PanelDetallesRestaurante()
        - actualizarRestaurante(nombre : String, calificacion : int, visitado : boolean) : void
        + actualizarRestaurante(r : Restaurante) : void
        - buscarIconoCalificacion(calificacion : int) : ImageIcon
    }
}

' =====================================================================
' Interfaz - ventana para agregar restaurantes
' =====================================================================
package "uniandes.dpoo.swing.interfaz.agregar" {
    class VentanaAgregarRestaurante {
        - panelDetalles : PanelEditarRestaurante
        - panelBotones : PanelBotonesAgregar
        - panelMapa : PanelMapaAgregar
        - ventanaPrincipal : VentanaPrincipal
        + VentanaAgregarRestaurante(principal : VentanaPrincipal)
        + agregarRestaurante() : void
        + cerrarVentana() : void
    }

    class PanelEditarRestaurante {
        - txtNombre : JTextField
        - cbbCalificacion : JComboBox<String>
        - cbbVisitado : JComboBox<String>
        + PanelEditarRestaurante()
        + getVisitado() : boolean
        + getCalificacion() : int
        + getNombre() : String
    }

    class PanelBotonesAgregar {
        - {static} CREAR : String = "nuevo"
        - {static} CERRAR : String = "ver"
        - butNuevo : JButton
        - butCerrar : JButton
        - ventanaPrincipal : VentanaAgregarRestaurante
        + PanelBotonesAgregar(ventanaPrincipal : VentanaAgregarRestaurante)
        + actionPerformed(e : ActionEvent) : void
    }

    class PanelMapaAgregar {
        - labMapa : JLabel
        - x : int
        - y : int
        + PanelMapaAgregar()
        + getCoordenadas() : int[]
        + paint(g : Graphics) : void
        + mouseClicked(e : MouseEvent) : void
        + mousePressed(e : MouseEvent) : void
        + mouseReleased(e : MouseEvent) : void
        + mouseEntered(e : MouseEvent) : void
        + mouseExited(e : MouseEvent) : void
    }
}

' =====================================================================
' Superclases e interfaces de Swing / AWT
' =====================================================================
package "javax.swing" as swingTop #EEEEEE {
    class JFrame
}

package "javax.swing / java.awt.event / javax.swing.event" as swingBottom #EEEEEE {
    class JPanel
    interface ActionListener {
        + actionPerformed(e : ActionEvent) : void
    }
    interface MouseListener {
        + mouseClicked(e : MouseEvent) : void
        + mousePressed(e : MouseEvent) : void
        + mouseReleased(e : MouseEvent) : void
        + mouseEntered(e : MouseEvent) : void
        + mouseExited(e : MouseEvent) : void
    }
    interface ListSelectionListener {
        + valueChanged(e : ListSelectionEvent) : void
    }
}

' =====================================================================
' Asociaciones: ventanas -> paneles (composición, bidireccional)
' =====================================================================
VentanaPrincipal "1\n-ventanaPrincipal" *-down- "1\n-pBotones" PanelBotones
VentanaPrincipal "1\n-ventanaPrincipal" *-down- "1\n-pLista" PanelLista
VentanaPrincipal "1" *-down-> "1\n-pDetalles" PanelDetallesRestaurante

VentanaAgregarRestaurante "1" *-down-> "1\n-panelDetalles" PanelEditarRestaurante
VentanaAgregarRestaurante "1\n-ventanaPrincipal" *-down- "1\n-panelBotones" PanelBotonesAgregar
VentanaAgregarRestaurante "1" *-down-> "1\n-panelMapa" PanelMapaAgregar

VentanaMapa "1" *-down-> "1\n-panelMapa" PanelMapaVisualizar

' =====================================================================
' Asociaciones entre ventanas (bidireccionales)
' =====================================================================
VentanaPrincipal "1\n-ventanaPrincipal" -down- "0..1\n-ventanaAgregar" VentanaAgregarRestaurante
VentanaPrincipal "1\n-ventanaPrincipal" -down- "0..1\n-ventanaMapa" VentanaMapa

' =====================================================================
' Asociaciones con el mundo
' =====================================================================
VentanaPrincipal "1" -up-> "1\n-mundo" Diario
Diario "1" o-left-> "*\n-restaurantes" Restaurante
PanelMapaVisualizar -up-> "*\n-restaurantes" Restaurante
PanelDetallesRestaurante .up.> Restaurante : <<use>>

' =====================================================================
' Herencia (superclases)
' =====================================================================
PanelBotones -down-|> JPanel
PanelLista -down-|> JPanel
PanelDetallesRestaurante -down-|> JPanel
PanelEditarRestaurante -down-|> JPanel
PanelBotonesAgregar -down-|> JPanel
PanelMapaAgregar -down-|> JPanel
PanelMapaVisualizar -down-|> JPanel

VentanaMapa -up-|> JFrame
VentanaPrincipal -up-|> JFrame
VentanaAgregarRestaurante -up-|> JFrame

' =====================================================================
' Implementación de interfaces
' =====================================================================
PanelBotones .down.|> ActionListener
PanelBotonesAgregar .down.|> ActionListener
VentanaMapa .down.|> ActionListener
PanelMapaAgregar .down.|> MouseListener
PanelLista .down.|> ListSelectionListener

@enduml
